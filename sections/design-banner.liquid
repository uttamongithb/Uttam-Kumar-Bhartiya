{% comment %}Banner section replicating design/index.html {% endcomment %}
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background: #fff; overflow-x: hidden; }
  body { -webkit-font-smoothing: antialiased; }
  .f-jost { font-family: 'Jost', 'Segoe UI', system-ui, sans-serif; }
  .f-lustria { font-family: 'Lustria', Georgia, serif; }
  /* ================= DESKTOP (>=768px) ================= */
  #desktopView { display: block; }
  #mobileView { display: none; }
  @media (max-width: 767.98px) {
    #desktopView { display: none; }
    #mobileView { display: block; }
  }
  html.force-mobile #desktopView { display: none !important; }
  html.force-mobile #mobileView { display: block !important; }
  html.force-desktop #desktopView { display: block !important; }
  html.force-desktop #mobileView { display: none !important; }
  #fitwrap { width: 100%; overflow: hidden; position: relative; }
  #stage {
    width: 1440px;
    background: #fff;
    transform-origin: top left;
    padding-bottom: 90px;
  }
  .bar { background: #f5f5f5; overflow: hidden; padding: 10px 0; width: 1440px; }
  .mq { overflow: hidden; width: 100%; }
  .mq-track { display: flex; width: max-content; animation: mq-scroll 46s linear infinite; }
  .mq:hover .mq-track { animation-play-state: paused; }
  .mq-seq { display: flex; gap: 360px; padding-right: 360px; align-items: center; }
  @keyframes mq-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .mq-item { display: flex; align-items: center; }
  .mq-item .logo-mark { width: 64.31px; height: 18.82px; display: block; }
  .mq-item .logo-word { width: 74.79px; height: 19px; display: block; margin-left: 12.35px; }
  .mq-item .tagline { font-family: 'Jost', 'Segoe UI', system-ui, sans-serif; font-size: 16px; line-height: 1.2; color: #000; margin-left: 48px; white-space: nowrap; }
  .mq-item .cta--top { position: relative; margin-left: 32px; }
  .bar--sub-static { display: flex; align-items: center; justify-content: center; padding: 10px 50px; }
  .bar--sub-static p { font-family: 'Jost', 'Segoe UI', system-ui, sans-serif; font-size: 16px; line-height: 1.2; color: #000; text-align: center; letter-spacing: .01em; }
  .bar--static { display: flex; align-items: center; padding: 10px 50px; }
  .nav-left { flex: 1; display: flex; align-items: center; }
  .nav-center { flex: 0 1 auto; text-align: center; font-family: 'Jost', 'Segoe UI', system-ui, sans-serif; font-size: 16px; line-height: 1.2; color: #000; white-space: nowrap; }
  .nav-right { flex: 1; display: flex; justify-content: flex-end; }
  .cta { border: 0; padding: 0; background: transparent; cursor: pointer; width: 220px; height: 50px; position: absolute; font: inherit; }
  .cta--top { width: 207px; height: 44px; }
  .cta .st { position: absolute; inset: 0; display: flex; align-items: center; transition: opacity .28s ease; }
  .cta .st .lbl { font-family: 'Jost', 'Segoe UI', system-ui, sans-serif; font-weight: 400; font-size: 16px; line-height: 1.28; text-transform: uppercase; white-space: nowrap; }
  .cta .st img.arr { position: absolute; left: 77.8%; top: 50%; transform: translateY(-50%); height: 11.05px; width: 26px; transition: transform .28s ease; }
  .cta--top .st img.arr { left: 77.8%; width: 25.5px; }
  .st--dark { background: #000; color: #fff; }
  .st--yellow { background: #fff544; color: #000; }
  .cta--dark .st--dark { opacity: 1; }
  .cta--dark .st--yellow { opacity: 0; }
  .cta--dark:hover .st--dark { opacity: 0; }
  .cta--dark:hover .st--yellow { opacity: 1; }
  .cta--yellow .st--yellow { opacity: 1; }
  .cta--yellow .st--dark { opacity: 0; }
  .cta--yellow:hover .st--yellow { opacity: 0; }
  .cta--yellow:hover .st--dark { opacity: 1; }
  .cta:hover img.arr { transform: translateY(-50%) translateX(4px); }
  .cta--hero { box-shadow: 0 2px 2px rgba(0,0,0,.2); }
  .cta--hero .st .lbl { padding-left: 55px; }
  .cta--top .st .lbl { padding-left: 33px; }
  .hero { position: relative; width: 1440px; height: 780px; background: #fff; }
  .hero .frame-a { position: absolute; left: 0; top: 0; width: 1440px; height: 390px; }
  .hero .frame-b { position: absolute; left: 550px; top: 378px; width: 890px; height: 402px; }
  .hero h1 { position: absolute; left: 67px; top: 425px; font-family: 'Jost', 'Segoe UI', system-ui, sans-serif; font-weight: 500; font-size: 70px; line-height: 1; color: #000; white-space: nowrap; }
  .hero .lede { position: absolute; left: 67px; top: 545px; width: 483px; font-family: 'Jost', 'Segoe UI', system-ui, sans-serif; font-weight: 400; font-size: 20px; line-height: 1.4; color: #000; }
  .hero .cta--hero { left: 67px; top: 679px; }
  .shop { width: 1337px; margin: 0 auto; padding-top: 64px; }
  .shop h2 { font-family: 'Lustria', Georgia, serif; font-weight: 400; font-size: 36px; line-height: 1.2; color: #000; white-space: nowrap; }
  .cards { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 30px; width: 1339px; }
  .card { position: relative; width: 433px; height: 444px; }
  .card img.photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .hotspot { position: absolute; width: 22px; height: 22px; border: 0; padding: 0; background: transparent; cursor: pointer; transition: transform .2s ease; }
  .hotspot img { width: 22px; height: 22px; display: block; }
  .hotspot:hover { transform: scale(1.25) rotate(90deg); }
  /* Mobile styles omitted for brevity */
</style>
<div id="desktopView">
  <div id="fitwrap">
    <div id="stage">
      <div class="bar bar--static">
        <div class="nav-left">
          <img class="logo-mark" src="{{ 'logo-mark.svg' | asset_url }}" alt="Tisso logo">
          <img class="logo-word" src="{{ 'logo-word.svg' | asset_url }}" alt="">
        </div>
        <p class="nav-center">Find the ideal gift for your loved ones.</p>
        <div class="nav-right">
          <button class="cta cta--top cta--yellow cta--nav" type="button" aria-label="Choose gift">
            <span class="st st--yellow"><span class="lbl">Choose Gift</span><img class="arr" src="{{ 'line17.svg' | asset_url }}" alt=""></span>
            <span class="st st--dark"><span class="lbl">Choose Gift</span><img class="arr" src="{{ 'line16.svg' | asset_url }}" alt=""></span>
          </button>
        </div>
      </div>
      <section class="hero">
        <img class="frame-a" src="{{ 'frame.svg' | asset_url }}" alt="">
