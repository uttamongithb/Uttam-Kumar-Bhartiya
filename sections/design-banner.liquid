          <span class="st st--yellow"><span class="lbl">Shop Now</span><img class="arr" src="{{ 'line15.svg' | asset_url }}" alt=""></span>
        </button>
      </section>
      <div class="bar bar--sub-static">
        <p>SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</p>
      </div>
      <section class="shop">
        <h2>Tisso vison in the wild</h2>
        <div class="cards">
          <div class="card">
            <img class="photo" src="{{ 'image822.png' | asset_url }}" alt="Black leather handbag worn crossbody">
            <button class="hotspot" style="left:256.5px; top:238px;" aria-label="Quick view product"><img src="{{ 'hotspot-190.svg' | asset_url }}" alt=""></button>
          </div>
          <div class="card">
            <img class="photo" src="{{ 'image823.png' | asset_url }}" alt="Product photo">
            <button class="hotspot" style="left:355.5px; top:222px;" aria-label="Quick view product"><img src="{{ 'hotspot-185.svg' | asset_url }}" alt=""></button>
          </div>
          <div class="card">
            <img class="photo" src="{{ 'image824.png' | asset_url }}" alt="Red and black checked flannel shirt">
            <button class="hotspot" style="left:261px; top:82px;" aria-label="Quick view product"><img src="{{ 'hotspot-186.svg' | asset_url }}" alt=""></button>
          </div>
          <div class="card">
            <img class="photo" src="{{ 'image825.png' | asset_url }}" alt="Product photo">
            <button class="hotspot" style="left:301.5px; top:71px;" aria-label="Quick view product"><img src="{{ 'hotspot-188.svg' | asset_url }}" alt=""></button>
          </div>
          <div class="card">
            <img class="photo" src="{{ 'image826.png' | asset_url }}" alt="Product photo">
            <button class="hotspot" style="left:212.5px; top:104px;" aria-label="Quick view product"><img src="{{ 'hotspot-189.svg' | asset_url }}" alt=""></button>
          </div>
          <div class="card">
            <img class="photo" src="{{ 'image827.png' | asset_url }}" alt="Product photo">
            <button class="hotspot" style="left:319.5px; top:164px;" aria-label="Quick view product"><img src="{{ 'hotspot-187.svg' | asset_url }}" alt=""></button>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
