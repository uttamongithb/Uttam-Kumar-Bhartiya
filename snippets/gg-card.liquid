{%- comment -%}
  One shoppable gallery card.
  Params: idx (0-5 hotspot position), prod (product object), mode ('desktop'|'mobile'),
          def_desc (fallback description when the product has none).
  Cards render ONLY real Shopify products — no fake/default products.
{%- endcomment -%}
{%- assign dhs = '256.5px,238px|355.5px,222px|261px,82px|301.5px,71px|212.5px,104px|319.5px,164px' | split: '|' -%}
{%- assign mhs = '59.238%,53.604%|82.102%,50%|60.277%,18.468%|69.63%,15.991%|49.076%,23.423%|73.788%,36.937%' | split: '|' -%}
{%- if mode == 'desktop' -%}
  {%- assign hs = dhs[idx] | split: ',' -%}
  {%- assign cls = 'card' -%}
{%- else -%}
  {%- assign hs = mhs[idx] | split: ',' -%}
  {%- assign cls = 'm-card' -%}
{%- endif -%}
{%- assign cdesc = prod.description | strip_html | truncate: 160 -%}
{%- if cdesc == blank -%}{%- assign cdesc = def_desc -%}{%- endif -%}
<div class="{{ cls }}" data-name="{{ prod.title | escape }}" data-price="{{ prod.price | money | escape }}" data-variant-id="{{ prod.selected_or_first_available_variant.id }}"{% if cdesc != blank %} data-desc="{{ cdesc | escape }}"{% endif %}>
  {%- if prod.featured_image -%}
    {{ prod.featured_image | image_url: width: 900 | image_tag: class: 'photo', loading: 'lazy', alt: prod.featured_image.alt | default: prod.title }}
  {%- else -%}
    {{ 'product-1' | placeholder_svg_tag: 'photo' }}
  {%- endif -%}
  <button class="hotspot" style="left:{{ hs[0] }}; top:{{ hs[1] }};" aria-label="Quick view product"><img src="{{ 'hotspot-190.svg' | asset_url }}" alt=""></button>
</div>
